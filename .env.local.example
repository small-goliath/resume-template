# ===========================================
# 환경변수 설정 가이드
# ===========================================
# 이 파일을 복사하여 .env.local로 저장하고 실제 값으로 변경하세요.
#
# 사용법:
#   cp .env.local.example .env.local
#   vi .env.local  # 실제 값 입력
#
# ⚠️ 주의: .env.local 파일은 Git에 커밋하지 마세요!

# ===========================================
# Supabase 설정
# ===========================================
# Supabase Dashboard → Settings → API에서 확인
# URL 형식: https://xxxxxxxxxxxxx.supabase.co
SUPABASE_URL=your-supabase-project-url

# 공개 읽기 전용 키 (anon key)
# 클라이언트에서 안전하게 사용 가능
SUPABASE_ANON_KEY=your-anon-key

# 서비스 역할 키 (service_role key)
# ⚠️ 절대 클라이언트에 노출하지 마세요!
# 서버 사이드에서만 사용 (쓰기 권한)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# 관리자 인증
# ===========================================
# 관리자 로그인에 사용되는 비밀 토큰
# 예: openssl rand -base64 32 명령으로 생성
# 강력한 무작위 문자열을 사용하세요 (최소 32자)
ADMIN_SECRET_TOKEN=your-secure-admin-token

# ===========================================
# API URL 설정
# ===========================================
# Next.js 클라이언트가 API를 호출할 때 사용하는 URL
#
# 로컬 개발: /api (상대 경로 권장)
# 프로덕션: /api (Vercel same-origin)
#
# ⚠️ NEXT_PUBLIC_ 프리픽스는 클라이언트에 노출됩니다
NEXT_PUBLIC_API_URL=/api

# ===========================================
# 선택적 설정 (필요시 추가)
# ===========================================
# Vercel Analytics
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# Sentry (에러 추적)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# ===========================================
# 개발자 노트
# ===========================================
# 1. 환경변수 검증: npm run dev 실행 시 자동 확인
# 2. 빌드 시 환경변수: .env.local은 자동으로 포함됨
# 3. Vercel 배포: Dashboard에서 별도로 환경변수 설정 필요
# 4. 문제 해결: docs/LOCAL_DEVELOPMENT.md 참조
